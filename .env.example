# Copy to .env, restrict its permissions, and set a unique password.
# No default password is supplied. Never commit the populated file.
# Use stock-radar-production in .env.production to isolate containers and volumes.
COMPOSE_PROJECT_NAME=stock-radar
POSTGRES_USER=stock_radar
POSTGRES_DB=stock_radar
POSTGRES_PASSWORD=

APP_POSTGRES_PASSWORD=
API_READER_TOKEN=
API_PORT=8000

API_COLLECTOR_TOKEN=
COLLECTOR_POSTGRES_PASSWORD=

WEBHOOK_TOKEN=
WEBHOOK_POSTGRES_PASSWORD=
